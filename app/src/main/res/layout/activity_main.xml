<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_1">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- Top Navigation -->
            <TextView
                android:id="@+id/tvMangata"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/serenity"
                android:text="M A N G A T A"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/serenity"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="MONDAY, MAY 4 2026" />

            <!-- Moon Display Area -->
            <ImageView
                android:id="@+id/ivMoon"
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:layout_marginTop="40dp"
                android:contentDescription="Moon Phase Image"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvMangata"
                tools:src="@drawable/moon_placeholder" />

            <TextView
                android:id="@+id/btnPrev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:text="&lt;"
                android:textColor="#FFFFFF"
                android:textSize="40sp"
                app:layout_constraintBottom_toBottomOf="@id/ivMoon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/ivMoon" />

            <TextView
                android:id="@+id/btnNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:text="&gt;"
                android:textColor="#FFFFFF"
                android:textSize="40sp"
                app:layout_constraintBottom_toBottomOf="@id/ivMoon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/ivMoon" />

            <!-- Divider -->
            <ImageView
                android:id="@+id/dividerTop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:adjustViewBounds="true"
                android:contentDescription="Divider"
                android:scaleType="fitCenter"
                android:src="@drawable/top"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivMoon" />

            <!-- Main Title -->
            <TextView
                android:id="@+id/tvMoonPhase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/higuen"
                android:textColor="#FFFFFF"
                android:textSize="45sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dividerTop"
                tools:text="Full Moon" />

            <!-- Icon Grid/Row -->
            <LinearLayout
                android:id="@+id/llMoonTimes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:weightSum="4"
                app:layout_constraintTop_toBottomOf="@id/tvMoonPhase">

                <TextView
                    android:id="@+id/tvTime1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/serenity"
                    android:gravity="center"
                    android:text="🌙\n8:08\nPM"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvTime2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/serenity"
                    android:gravity="center"
                    android:text="🌙\n6:58\nAM"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvTime3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/serenity"
                    android:gravity="center"
                    android:text="☀️\n5:26\nAM"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvTime4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/serenity"
                    android:gravity="center"
                    android:text="☀️\n5:57\nPM"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Details Section -->
            <TableLayout
                android:id="@+id/tlDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:stretchColumns="1"
                app:layout_constraintTop_toBottomOf="@id/llMoonTimes">

                <TableRow android:layout_marginBottom="8dp">
                    <TextView
                        android:fontFamily="@font/cotoris"
                        android:text="ILLUMINATION:"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />
                    <TextView
                        android:id="@+id/tvIllumination"
                        android:layout_width="wrap_content"
                        android:layout_column="2"
                        android:fontFamily="@font/cotoris"
                        android:gravity="end"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        tools:text="67%" />
                </TableRow>

                <TableRow android:layout_marginBottom="8dp">
                    <TextView
                        android:fontFamily="@font/cotoris"
                        android:text="DISTANCE:"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />
                    <TextView
                        android:id="@+id/tvDistance"
                        android:layout_width="wrap_content"
                        android:layout_column="2"
                        android:fontFamily="@font/cotoris"
                        android:gravity="end"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        tools:text="405,905 KM" />
                </TableRow>

                <TableRow android:layout_marginBottom="8dp">
                    <TextView
                        android:fontFamily="@font/cotoris"
                        android:text="MOON AGE:"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />
                    <TextView
                        android:id="@+id/tvMoonAge"
                        android:layout_width="wrap_content"
                        android:layout_column="2"
                        android:fontFamily="@font/cotoris"
                        android:gravity="end"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        tools:text="17.3 DAYS" />
                </TableRow>

                <TableRow android:layout_marginBottom="8dp">
                    <TextView
                        android:fontFamily="@font/cotoris"
                        android:text="MOON ZODIAC:"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />
                    <TextView
                        android:id="@+id/tvZodiac"
                        android:layout_width="wrap_content"
                        android:layout_column="2"
                        android:fontFamily="@font/cotoris"
                        android:gravity="end"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        tools:text="SAGITTARIUS" />
                </TableRow>
            </TableLayout>

            <!-- Interpretation Section -->
            <TextView
                android:id="@+id/tvInterpretationHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/cotoris"
                android:gravity="center"
                android:text="@string/interpretation_header"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tlDetails" />

            <TextView
                android:id="@+id/tvInterpretationBody"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/cotoris"
                android:gravity="center"
                android:justificationMode="inter_word"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvInterpretationHeader"
                tools:text="Interpretation body text..." />

            <ImageView
                android:id="@+id/dividerInterpretation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:adjustViewBounds="true"
                android:contentDescription="Interpretation Divider"
                android:scaleType="fitCenter"
                android:src="@drawable/bto"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvInterpretationBody" />

            <!-- Special Section -->
            <TextView
                android:id="@+id/tvSpecialHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/cotoris"
                android:gravity="center"
                android:text="@string/special_header"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dividerInterpretation" />

            <TextView
                android:id="@+id/tvSpecialBody"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/cotoris"
                android:gravity="center"
                android:justificationMode="inter_word"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSpecialHeader"
                tools:text="Special information text..." />

            <ImageView
                android:id="@+id/dividerSpecial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:adjustViewBounds="true"
                android:contentDescription="Special Divider"
                android:scaleType="fitCenter"
                android:src="@drawable/bto"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSpecialBody" />

            <!-- Forecast Section -->
            <TextView
                android:id="@+id/tvForecastHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/cotoris"
                android:gravity="center"
                android:text="@string/forecast_header"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dividerSpecial" />

            <TextView
                android:id="@+id/tvForecastBody"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:fontFamily="@font/cotoris"
                android:gravity="center"
                android:justificationMode="inter_word"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvForecastHeader"
                tools:text="Forecast information text..." />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>